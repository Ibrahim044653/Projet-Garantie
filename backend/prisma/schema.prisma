generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums existants ──────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  GESTIONNAIRE_GARANTIES
  RESPONSABLE_RISQUES
  ENGAGEMENTS
  AUDIT_INTERNE
}

enum NatureBien {
  TERRAIN_NU
  VILLA
  IMMEUBLE_RAPPORT
  USINE
  BUREAU
}

enum ZoneGeographique {
  ZONE_A
  ZONE_B
  ZONE_C
  ZONE_INDUSTRIELLE
}

enum StatutOccupation {
  LIBRE
  OCCUPE_PROPRIETAIRE
  LOUE_AVEC_BAIL
}

enum AlertType {
  SHORTFALL
  EXPERTISE_EXPIREE
  EXPERTISE_BIENTOT_EXPIREE
  EXPERTISE_RENOUVELLEMENT
  INSCRIPTION_PERIMEE
}

// ─── Enums v2 ─────────────────────────────────────────────────────────────────

// CRM Client
enum TypeClient {
  PARTICULIER
  ENTREPRISE
}

enum StatutClient {
  ACTIF
  INACTIF
  BLACKLISTE
}

// Loan Management
enum TypeAmortissement {
  LINEAIRE
  CONSTANT
  IN_FINE
}

enum StatutPret {
  ACTIF
  EN_DEFAUT
  CLOTURE
  RENEGOCIE
  SOLDE
}

enum StatutEcheance {
  EN_ATTENTE
  PAYE
  PARTIEL
  IMPAYE
}

// Workflow
enum TypeDemande {
  CREATION_HYPOTHEQUE
  REEVALUATION
  RADIATION
  CREATION_PRET
  MODIFICATION_PRET
}

enum StatutDemande {
  EN_ATTENTE
  EN_COURS
  APPROUVE
  REJETE
  ANNULE
}

enum StatutEtape {
  EN_ATTENTE
  APPROUVE
  REJETE
}

// ─── Models existants ─────────────────────────────────────────────────────────

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  nom        String
  prenom     String
  role       UserRole @default(GESTIONNAIRE_GARANTIES)
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  demandesCreees    DemandeValidation[]       @relation("CreateurDemande")
  etapesValidees    EtapeValidation[]         @relation("ValideurEtape")
  documentVersions  DocumentVersion[]         @relation("VersionsUploaded")
  notifications     Notification[]            @relation("UserNotifications")
  pushSubscriptions WebPushSubscription[]     @relation("UserPushSubs")
  reevaluationsCreees ReevaluationExpertise[] @relation("ReevaluationsCreees")
  exportsPlanifies  ExportPlanifie[]          @relation("ExportsPlanifies")
  dashboardConfig   DashboardConfig?          @relation("UserDashboardConfig")
  mainlevees           MainleveeRadiation[]  @relation("MainleveeCreatedBy")
  dossierRecouvrement  DossierRecouvrement[] @relation("RecouvrementCreatedBy")
  auditLogs            AuditLog[]            @relation("AuditLogUser")

  @@index([role])
}

model Hypotheque {
  id                        Int              @id @default(autoincrement())
  codeClient                String
  nomClient                 String
  numeroPret                String           @unique
  numeroTitreFoncier        String
  natureBien                NatureBien
  ville                     String
  quartier                  String?
  lot                       String?
  ilot                      String?
  zoneGeographique          ZoneGeographique
  statutOccupation          StatutOccupation
  valeurExpertiseInitiale   Decimal          @db.Decimal(18, 2)
  dateExpertise             DateTime         @db.Timestamptz
  montantInscription        Decimal          @default(0) @db.Decimal(18, 2)
  rangHypotheque            Int              @default(1)
  datePeremptionInscription DateTime         @db.Timestamptz
  soldePret                 Decimal          @default(0) @db.Decimal(18, 2)
  dateEcheancePret          DateTime?        @db.Timestamptz
  pjExpertisePath           String?
  // FK v2
  clientId                  Int?
  pretId                    Int?
  createdAt                 DateTime         @default(now()) @db.Timestamptz
  updatedAt                 DateTime         @updatedAt @db.Timestamptz
  latitude                  Float?
  longitude                 Float?

  historique     HistoriqueValeur[]
  alertes        Alert[]
  client         Client?                 @relation(fields: [clientId], references: [id])
  pret           Pret?                   @relation(fields: [pretId], references: [id])
  documents      Document[]              @relation("HypothequeDocuments")
  assurances     Assurance[]             @relation("HypothequeAssurances")
  reevaluations  ReevaluationExpertise[] @relation("HypothequeReevaluations")
  mainlevees     MainleveeRadiation[]    @relation("HypothequeMainlevees")

  @@unique([numeroTitreFoncier, rangHypotheque])
  @@index([nomClient])
  @@index([codeClient])
  @@index([clientId])
  @@index([pretId])
  @@index([ville])
  @@index([zoneGeographique])
  @@index([rangHypotheque])
  @@index([dateExpertise])
  @@index([datePeremptionInscription])
  @@index([createdAt])
}

model HistoriqueValeur {
  id                    Int              @id @default(autoincrement())
  hypothequeId          Int
  valeurExpertise       Decimal          @db.Decimal(18, 2)
  dateExpertise         DateTime         @db.Timestamptz
  zoneGeographique      ZoneGeographique
  statutOccupation      StatutOccupation
  decoteZone            Decimal          @db.Decimal(5, 2)
  decoteAnciennete      Decimal          @db.Decimal(5, 2)
  decoteOccupation      Decimal          @db.Decimal(5, 2)
  decoteTotale          Decimal          @db.Decimal(5, 2)
  valeurNetteCouverture Decimal          @db.Decimal(18, 2)
  loanToValue           Decimal          @db.Decimal(10, 4)
  modifiePar            String
  motif                 String?
  dateModification      DateTime         @default(now()) @db.Timestamptz

  hypotheque Hypotheque @relation(fields: [hypothequeId], references: [id], onDelete: Cascade)

  @@index([hypothequeId])
  @@index([hypothequeId, dateModification])
}

model Alert {
  id           Int       @id @default(autoincrement())
  hypothequeId Int
  type         AlertType
  message      String
  dateEcheance DateTime? @db.Timestamptz
  lu           Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz

  hypotheque Hypotheque @relation(fields: [hypothequeId], references: [id], onDelete: Cascade)

  @@index([hypothequeId])
  @@index([hypothequeId, lu])
  @@index([type])
  @@index([lu])
  @@index([createdAt])
}

// ─── Module CRM Client ────────────────────────────────────────────────────────

model Client {
  id             Int          @id @default(autoincrement())
  codeClient     String       @unique
  typeClient     TypeClient   @default(PARTICULIER)
  nom            String
  prenom         String?
  raisonSociale  String?
  telephone      String?
  email          String?
  adresse        String?
  ville          String?
  dateNaissance  DateTime?    @db.Date
  numeroIdentite String?
  statut         StatutClient @default(ACTIF)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  prets       Pret[]
  hypotheques Hypotheque[]
  documents   Document[]   @relation("ClientDocuments")
  assurances  Assurance[]  @relation("ClientAssurances")

  @@index([nom])
  @@index([codeClient])
  @@index([statut])
  @@index([typeClient])
}

// ─── Module Loan Management ───────────────────────────────────────────────────

model Pret {
  id                Int               @id @default(autoincrement())
  numeroPret        String            @unique
  clientId          Int
  montantInitial    Decimal           @db.Decimal(18, 2)
  montantRestant    Decimal           @db.Decimal(18, 2)
  tauxInteret       Decimal           @db.Decimal(7, 4)
  dureeMois         Int
  typeAmortissement TypeAmortissement @default(LINEAIRE)
  dateDebut         DateTime          @db.Timestamptz
  dateFin           DateTime          @db.Timestamptz
  statut            StatutPret        @default(ACTIF)
  objet             String?
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  client       Client               @relation(fields: [clientId], references: [id])
  echeances    EcheancePret[]
  hypotheques  Hypotheque[]
  documents    Document[]           @relation("PretDocuments")
  assurances   Assurance[]          @relation("PretAssurances")
  recouvrement DossierRecouvrement? @relation("PretRecouvrement")

  @@index([clientId])
  @@index([statut])
  @@index([dateDebut])
  @@index([numeroPret])
}

model EcheancePret {
  id                 Int            @id @default(autoincrement())
  pretId             Int
  numeroEcheance     Int
  dateEcheance       DateTime       @db.Timestamptz
  capitalDu          Decimal        @db.Decimal(18, 2)
  interetsDus        Decimal        @db.Decimal(18, 2)
  montantTotal       Decimal        @db.Decimal(18, 2)
  capitalRembourse   Decimal        @default(0) @db.Decimal(18, 2)
  interetsRembourses Decimal        @default(0) @db.Decimal(18, 2)
  penalites          Decimal        @default(0) @db.Decimal(18, 2)
  montantPaye        Decimal        @default(0) @db.Decimal(18, 2)
  statut             StatutEcheance @default(EN_ATTENTE)
  datePaiement       DateTime?      @db.Timestamptz
  commentaire        String?

  pret Pret @relation(fields: [pretId], references: [id], onDelete: Cascade)

  @@unique([pretId, numeroEcheance])
  @@index([pretId])
  @@index([pretId, statut])
  @@index([dateEcheance])
  @@index([statut])
}

// ─── Module Workflow ──────────────────────────────────────────────────────────

model DemandeValidation {
  id            Int           @id @default(autoincrement())
  type          TypeDemande
  entiteId      Int
  entiteType    String
  titre         String
  description   String?
  statut        StatutDemande @default(EN_ATTENTE)
  createurId    Int
  etapeActuelle Int           @default(1)
  totalEtapes   Int           @default(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  createur User              @relation("CreateurDemande", fields: [createurId], references: [id])
  etapes   EtapeValidation[]

  @@index([statut])
  @@index([createurId])
  @@index([entiteId, entiteType])
  @@index([type])
}

model EtapeValidation {
  id             Int         @id @default(autoincrement())
  demandeId      Int
  numeroEtape    Int
  libelle        String
  roleRequis     UserRole
  valideurId     Int?
  statut         StatutEtape @default(EN_ATTENTE)
  commentaire    String?
  dateTraitement DateTime?   @db.Timestamptz
  createdAt      DateTime    @default(now()) @db.Timestamptz

  demande  DemandeValidation @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  valideur User?             @relation("ValideurEtape", fields: [valideurId], references: [id])

  @@unique([demandeId, numeroEtape])
  @@index([demandeId])
  @@index([statut])
  @@index([roleRequis])
}

// ─── GED — Gestion Électronique des Documents ─────────────────────────────────

enum TypeDocument {
  ACTE_PROPRIETE
  RAPPORT_EXPERTISE
  TITRE_FONCIER
  MAINLEVEE
  CONTRAT_PRET
  ACCORD_CREDIT
  POLICE_ASSURANCE
  AVENANT_ASSURANCE
  AUTRE
}

enum StatutDocument {
  ACTIF
  ARCHIVE
  REJETE
}

model Document {
  id              Int            @id @default(autoincrement())
  titre           String
  type            TypeDocument
  description     String?
  hypothequeId    Int?
  pretId          Int?
  clientId        Int?
  statut          StatutDocument @default(ACTIF)
  versionActuelle Int            @default(1)
  tags            String?        // JSON array stored as string e.g. '["urgent","bceao"]'
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  hypotheque Hypotheque?      @relation("HypothequeDocuments", fields: [hypothequeId], references: [id])
  pret       Pret?            @relation("PretDocuments", fields: [pretId], references: [id])
  client     Client?          @relation("ClientDocuments", fields: [clientId], references: [id])
  versions   DocumentVersion[]

  @@index([hypothequeId])
  @@index([pretId])
  @@index([clientId])
  @@index([type])
  @@index([statut])
}

model DocumentVersion {
  id            Int      @id @default(autoincrement())
  documentId    Int
  numeroVersion Int
  filePath      String   @default("")
  fileName      String
  mimeType      String
  taille        Int
  fileContent   Bytes?
  commentaire   String?
  uploadedById  Int
  createdAt     DateTime @default(now()) @db.Timestamptz

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("VersionsUploaded", fields: [uploadedById], references: [id])

  @@unique([documentId, numeroVersion])
  @@index([documentId])
}

// ─── Module Assurances ────────────────────────────────────────────────────────

enum TypeAssurance {
  DECES_INVALIDITE
  INCENDIE_CATASTROPHE
  MULTIRISQUE_HABITATION
  DEFAILLANCE_CREDIT
  AUTRE
}

enum StatutAssurance {
  ACTIVE
  EXPIREE
  RESILIEE
  EN_ATTENTE
}

enum StatutSinistre {
  DECLARE
  EN_INSTRUCTION
  ACCEPTE
  REMBOURSE
  REJETE
}

model Assurance {
  id             Int             @id @default(autoincrement())
  numeroPolice   String          @unique
  compagnie      String
  typeAssurance  TypeAssurance
  pretId         Int?
  clientId       Int?
  hypothequeId   Int?
  montantAssure  Decimal         @db.Decimal(18, 2)
  primeMensuelle Decimal?        @db.Decimal(18, 2)
  primeAnnuelle  Decimal?        @db.Decimal(18, 2)
  dateDebut      DateTime        @db.Date
  dateFin        DateTime        @db.Date
  statut         StatutAssurance @default(ACTIVE)
  beneficiaire   String?
  notes          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  pret       Pret?       @relation("PretAssurances", fields: [pretId], references: [id])
  client     Client?     @relation("ClientAssurances", fields: [clientId], references: [id])
  hypotheque Hypotheque? @relation("HypothequeAssurances", fields: [hypothequeId], references: [id])
  sinistres  Sinistre[]

  @@index([pretId])
  @@index([clientId])
  @@index([hypothequeId])
  @@index([statut])
  @@index([dateFin])
}

model Sinistre {
  id               Int            @id @default(autoincrement())
  assuranceId      Int
  dateDeclaration  DateTime       @db.Date
  dateSinistre     DateTime?      @db.Date
  montantDeclare   Decimal        @db.Decimal(18, 2)
  montantRembourse Decimal?       @db.Decimal(18, 2)
  statut           StatutSinistre @default(DECLARE)
  description      String?
  dateReglement    DateTime?      @db.Date
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz

  assurance Assurance @relation(fields: [assuranceId], references: [id], onDelete: Cascade)

  @@index([assuranceId])
  @@index([statut])
}

// ─── Module Notifications ─────────────────────────────────────────────────────

enum NotificationType {
  ALERTE_EXPIRATION
  SHORTFALL_DETECTE
  WORKFLOW_EN_ATTENTE
  WORKFLOW_APPROUVE
  WORKFLOW_REJETE
  ECHEANCE_PROCHE
  EXPERTISE_RENOUVELER
  ASSURANCE_EXPIRATION
  SYSTEME
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int?
  type       NotificationType
  titre      String
  message    String
  entiteType String?
  entiteId   Int?
  lu         Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz

  user User? @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lu])
  @@index([createdAt])
}

model WebPushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation("UserPushSubs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Module Réévaluation / Expertise ─────────────────────────────────────────

enum StatutExpert {
  ACTIF
  SUSPENDU
  RETIRE
}

enum TypeExport {
  HYPOTHEQUE_PDF
  RAPPORT_BCEAO
  RAPPORT_COMITE
  PORTEFEUILLE_CSV
}

enum FrequenceExport {
  MENSUEL
  TRIMESTRIEL
  SEMESTRIEL
  ANNUEL
}

model ExpertAgree {
  id             Int          @id @default(autoincrement())
  nom            String
  prenom         String?
  cabinet        String?
  telephone      String?
  email          String?
  numeroAgrement String       @unique
  dateAgrement   DateTime     @db.Date
  dateExpiration DateTime?    @db.Date
  statut         StatutExpert @default(ACTIF)
  specialites    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  reevaluations ReevaluationExpertise[]

  @@index([statut])
}

model ReevaluationExpertise {
  id              Int      @id @default(autoincrement())
  hypothequeId    Int
  dateExpertise   DateTime @db.Date
  valeurExpertise Decimal  @db.Decimal(18, 2)
  expertNom       String
  expertAgreeId   Int?
  observations    String?
  motif           String
  photoPaths      String?
  createdById     Int
  createdAt       DateTime @default(now()) @db.Timestamptz

  hypotheque  Hypotheque   @relation("HypothequeReevaluations", fields: [hypothequeId], references: [id])
  expertAgree ExpertAgree? @relation(fields: [expertAgreeId], references: [id])
  createdBy   User         @relation("ReevaluationsCreees", fields: [createdById], references: [id])

  @@index([hypothequeId])
  @@index([createdAt])
}

// ─── Dashboard personnalisable ────────────────────────────────────────────────

model DashboardConfig {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  config    String
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation("UserDashboardConfig", fields: [userId], references: [id], onDelete: Cascade)
}

model ExportPlanifie {
  id             Int             @id @default(autoincrement())
  type           TypeExport
  frequence      FrequenceExport
  prochainExport DateTime        @db.Timestamptz
  destinataires  String
  filtres        String?
  actif          Boolean         @default(true)
  createdById    Int
  createdAt      DateTime        @default(now()) @db.Timestamptz

  createdBy User @relation("ExportsPlanifies", fields: [createdById], references: [id])

  @@index([prochainExport])
  @@index([actif])
}

// ─── Enums features 5, 8, 9 ──────────────────────────────────────────────────

enum StatutMainlevee {
  EN_PREPARATION
  EN_ATTENTE_NOTAIRE
  EN_ATTENTE_CONSERVATION
  COMPLETE
  REJETE
}

enum StatutRecouvrement {
  PRE_CONTENTIEUX
  CONTENTIEUX
  JUDICIAIRE
  CLOTURE
}

enum StatutEcheanceApurement {
  EN_ATTENTE
  PAYE
  EN_RETARD
  PARTIEL
}

// ─── Feature 5: Mainlevée & Radiation ─────────────────────────────────────────

model MainleveeRadiation {
  id                       Int              @id @default(autoincrement())
  hypothequeId             Int
  hypotheque               Hypotheque       @relation("HypothequeMainlevees", fields: [hypothequeId], references: [id])
  statut                   StatutMainlevee  @default(EN_PREPARATION)
  motif                    String
  dateInitiation           DateTime         @default(now()) @db.Timestamptz
  dateNotaire              DateTime?        @db.Timestamptz
  referenceNotaire         String?
  dateConservationFonciere DateTime?        @db.Timestamptz
  referenceConservation    String?
  dateRadiation            DateTime?        @db.Timestamptz
  observations             String?
  documentGedIds           String?          // JSON array of Document.id
  createdById              Int
  createdBy                User             @relation("MainleveeCreatedBy", fields: [createdById], references: [id])
  updatedAt                DateTime         @updatedAt @db.Timestamptz
  createdAt                DateTime         @default(now()) @db.Timestamptz

  @@index([hypothequeId])
  @@index([statut])
  @@index([createdAt])
}

// ─── Feature 8: Recouvrement ──────────────────────────────────────────────────

model DossierRecouvrement {
  id               Int                  @id @default(autoincrement())
  pretId           Int                  @unique
  pret             Pret                 @relation("PretRecouvrement", fields: [pretId], references: [id])
  statut           StatutRecouvrement   @default(PRE_CONTENTIEUX)
  dateOuverture    DateTime             @default(now()) @db.Timestamptz
  montantDu        Decimal              @db.Decimal(18, 2)
  montantPenalites Decimal              @default(0) @db.Decimal(18, 2)
  observations     String?
  planApurement    PlanApurement?
  createdById      Int
  createdBy        User                 @relation("RecouvrementCreatedBy", fields: [createdById], references: [id])
  updatedAt        DateTime             @updatedAt @db.Timestamptz
  createdAt        DateTime             @default(now()) @db.Timestamptz

  @@index([statut])
  @@index([createdAt])
}

model PlanApurement {
  id              Int                   @id @default(autoincrement())
  dossierId       Int                   @unique
  dossier         DossierRecouvrement   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dateDebut       DateTime              @db.Timestamptz
  montantTotal    Decimal               @db.Decimal(18, 2)
  nombreEcheances Int
  periodeEcheance String                // MENSUEL, TRIMESTRIEL, SEMESTRIEL
  tauxPenalite    Decimal               @default(0) @db.Decimal(5, 4)
  echeances       EcheanceApurement[]
  createdAt       DateTime              @default(now()) @db.Timestamptz
}

model EcheanceApurement {
  id             Int                       @id @default(autoincrement())
  planId         Int
  plan           PlanApurement             @relation(fields: [planId], references: [id], onDelete: Cascade)
  numeroEcheance Int
  dateEcheance   DateTime                  @db.Timestamptz
  montant        Decimal                   @db.Decimal(18, 2)
  statut         StatutEcheanceApurement   @default(EN_ATTENTE)
  datePaiement   DateTime?                 @db.Timestamptz
  montantPaye    Decimal?                  @db.Decimal(18, 2)
  createdAt      DateTime                  @default(now()) @db.Timestamptz

  @@index([planId])
  @@index([dateEcheance])
}

// ─── Feature 9: Audit Trail ───────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  action    String   // CREATE, UPDATE, DELETE, VIEW, LOGIN, LOGOUT, EXPORT, SEARCH
  entite    String   // hypotheque, pret, client, user, mainlevee, recouvrement, etc.
  entiteId  String?
  details   String?  // JSON: { avant: {}, apres: {}, champs: [] }
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([action])
  @@index([entite])
  @@index([createdAt])
}
